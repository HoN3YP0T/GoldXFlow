# /etc/goldflow/goldflow.env  (chmod 600, owner goldflow). Secrets live here or in a keystore, never in the config.
BINANCE_API_KEY=
GOLDFLOW_BRIDGE_SECRET=
GOLDFLOW_DASHBOARD_TOKEN=
GOLDFLOW_BACKUP_DIR=/mnt/backup/goldflow
# GOLDFLOW_ALERT_WEBHOOK=https://hooks.example/...   (set ops.webhook_env to "GOLDFLOW_ALERT_WEBHOOK" to enable)
